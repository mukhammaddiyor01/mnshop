<%- include('includes/header', { pageTitle: 'MNShop Admin | Analytics', pageCss: '/css/analytics.css', pageScript: '/js/analytics.js' }) %>
<body class="admin-body" data-page="analytics">
  <%- include('includes/admin-shell-start', { page: 'analytics' }) %>

  <%
    const revenueDays = analytics?.revenueLast7Days || [];
    const categories = analytics?.categoryPerformance || [];
    const topProducts = analytics?.topProducts || [];
    const maxRevenue = Math.max(...revenueDays.map(function(day) { return day.revenue; }), 1);
  %>

  <div class="analytics-grid">
    <section class="glass-panel revenue-panel">
      <h3>Revenue Trend</h3>
      <p>Today: <%= Number(analytics?.revenueToday || 0).toLocaleString() %> KRW</p>
      <div class="bar-chart">
        <% revenueDays.forEach(function(day) { %>
          <div class="bar-item">
            <span data-bar-height="<%= Math.round((day.revenue / maxRevenue) * 100) %>"></span>
            <small><%= day.date.slice(5) %></small>
          </div>
        <% }) %>
      </div>
    </section>

    <section class="glass-panel category-panel">
      <h3>Category Performance</h3>
      <div class="category-progress">
        <% categories.forEach(function(item) { %>
          <article>
            <div>
              <strong><%= item.category %></strong>
              <small><%= item.sold %> sold</small>
            </div>
            <div class="progress-track">
              <span data-progress-width="<%= item.percentage %>"></span>
            </div>
          </article>
        <% }) %>
      </div>
    </section>

    <section class="glass-panel top-products-panel">
      <h3>Top Products by Revenue</h3>
      <div class="top-products-list">
        <% topProducts.forEach(function(product) { %>
          <article>
            <strong><%= product.productName %></strong>
            <span><%= Number(product.revenue || 0).toLocaleString() %> KRW</span>
          </article>
        <% }) %>
      </div>
    </section>
  </div>

  <%- include('includes/admin-shell-end') %>
  <%- include('includes/footer') %>
