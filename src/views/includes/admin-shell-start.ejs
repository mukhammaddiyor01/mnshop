<%
  const activePage = typeof page !== "undefined" ? page : "overview";
  const showFilters = ["users", "sellers", "products", "orders", "messages"].includes(activePage);
  const navItems = [
    { key: "home", label: "Home", href: "/admin", icon: "layout-dashboard" },
    { key: "login", label: "Login", href: "/admin/login", icon: "layout-dashboard" },
    { key: "overview", label: "Overview", href: "/admin/overview", icon: "layout-dashboard" },
    { key: "users", label: "Users", href: "/admin/users/all", icon: "users" },
    { key: "sellers", label: "Sellers", href: "/admin/sellers", icon: "user-check" },
    { key: "products", label: "Products", href: "/admin/product/all", icon: "boxes" },
    { key: "orders", label: "Orders", href: "/admin/orders", icon: "shopping-bag" },
    { key: "messages", label: "Messages", href: "/admin/messages", icon: "message-square" },
    { key: "analytics", label: "Analytics", href: "/admin/analytics", icon: "bar-chart-3" },
    { key: "settings", label: "Settings", href: "/admin/settings", icon: "settings" }
  ];
%>
<section class="admin-page">
  <div class="admin-layout">
    <button class="sidebar-backdrop" type="button" data-close-sidebar aria-label="Close menu"></button>
    <aside class="admin-sidebar" id="adminSidebar">
      <div class="sidebar-brand">
        <div>
          <p>MNSHOP Organization</p>
          <h1>Admin</h1>
        </div>
        <i data-lucide="shield-alert" aria-hidden="true"></i>
      </div>

      <nav class="side-nav" aria-label="Admin navigation">
        <% navItems.forEach(function(item) { %>
          <a class="side-link <%= activePage === item.key ? "active" : "" %>" href="<%= item.href %>">
            <span><i data-lucide="<%= item.icon %>" aria-hidden="true"></i><%= item.label %></span>
            <i data-lucide="chevron-right" aria-hidden="true"></i>
          </a>
        <% }) %>
      </nav>
    </aside>

    <main class="admin-main">
      <header class="admin-topbar">
        <div class="topbar-copy">
          <button class="mobile-menu" type="button" data-toggle-sidebar aria-label="Open menu">
            <span></span><span></span><span></span>
          </button>
          <div>
            <p>Platform Control</p>
            <h2>Admin Panel</h2>
            <small>Live controls are ready in this demo dashboard.</small>
          </div>
        </div>

        <% if (showFilters) { %>
          <div class="topbar-filters">
            <label class="search-box">
              <i data-lucide="search" aria-hidden="true"></i>
              <input type="search" placeholder="Search <%= activePage %>" data-admin-search />
            </label>
            <select class="filter-select" data-status-filter>
              <option value="all">All status</option>
              <% if (activePage === "orders") { %>
                <% ["pending", "processing", "shipped", "delivered", "cancelled"].forEach(function(status) { %>
                  <option value="<%= status %>"><%= status %></option>
                <% }) %>
              <% } else { %>
                <% ["active", "blocked", "pending", "rejected", "draft"].forEach(function(status) { %>
                  <option value="<%= status %>"><%= status %></option>
                <% }) %>
              <% } %>
            </select>
          </div>
        <% } %>
      </header>

      <section class="admin-content">
