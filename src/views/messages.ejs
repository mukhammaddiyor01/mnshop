<%- include('includes/header', { pageTitle: 'MNShop Admin | Messages', pageCss: '/css/messages.css', pageScript: '/js/messages.js' }) %>
<body class="admin-body" data-page="messages">
  <%- include('includes/admin-shell-start', { page: 'messages' }) %>

  <section class="chat-shell">
    <aside class="conversation-list" data-search-target>
      <% [
        ["Buyer support: hoodie size", "buyer", 2],
        ["Seller moderation request", "seller", 1],
        ["Payment question", "support", 0]
      ].forEach(function(chat, index) { %>
        <button class="conversation-item <%= index === 0 ? "active" : "" %>" type="button" data-conversation data-status="active">
          <span><strong><%= chat[0] %></strong><small><%= chat[1] %></small></span>
          <% if (chat[2]) { %><em><%= chat[2] %></em><% } %>
        </button>
      <% }) %>
    </aside>
    <div class="message-thread">
      <div class="thread-head"><h3 data-thread-title>Buyer support: hoodie size</h3><p>Moderation and support conversation</p></div>
      <div class="message-list" id="messageList">
        <div class="message bubble-left"><small>Madina · 12:20</small><p>M razmer oversized bo'ladimi?</p></div>
        <div class="message bubble-right"><small>Admin · 12:23</small><p>Ha, mnshop_blueprint hoodielar loose fit.</p></div>
      </div>
      <form class="message-form" data-message-form><input type="text" name="message" placeholder="Reply as admin" autocomplete="off" /><button type="submit">Send</button></form>
    </div>
  </section>

  <%- include('includes/admin-shell-end') %>
  <%- include('includes/footer') %>
