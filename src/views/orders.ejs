<%- include('includes/header', { pageTitle: 'MNShop Admin | Orders', pageCss: '/css/orders.css', pageScript: '/js/orders.js' }) %>
<body class="admin-body" data-page="orders">
  <%- include('includes/admin-shell-start', { page: 'orders', heading: 'Orders', eyebrow: 'Buyer checkout and seller fulfillment' }) %>

  <div class="toolbar">
    <div>
      <h2>Order Queue</h2>
      <p>View order totals, payment state, delivery progress, and seller ownership.</p>
    </div>
    <button class="submit-btn" type="button" data-toast="Order report exported">Export Orders</button>
  </div>

  <section class="panel">
    <div class="table-wrap">
      <table class="admin-table" data-search-target>
        <thead>
          <tr>
            <th>Order</th>
            <th>Buyer</th>
            <th>Items</th>
            <th>Total</th>
            <th>Payment</th>
            <th>Delivery</th>
            <th>Status</th>
          </tr>
        </thead>
        <tbody>
          <% [
            ["MN-2048", "Madina Sobirova", "Hoodie, Cap", "879,000 UZS", "PAID", "SHIPPED", "PROCESSING"],
            ["MN-2049", "Azizbek Karimov", "T-Shirt", "279,000 UZS", "PENDING", "PREPARING", "PENDING"],
            ["MN-2050", "Sevara Aliyeva", "Cup x2", "280,000 UZS", "PAID", "DELIVERED", "DELIVERED"]
          ].forEach(function(order) { %>
            <tr>
              <td><strong><%= order[0] %></strong><small>2026-07-17</small></td>
              <td><%= order[1] %></td>
              <td><%= order[2] %></td>
              <td><%= order[3] %></td>
              <td><span class="status-pill <%= order[4] === "PAID" ? "success" : "warning" %>"><%= order[4] %></span></td>
              <td><%= order[5] %></td>
              <td>
                <select class="status-change" data-toast="Order status changed">
                  <option <%= order[6] === "PENDING" ? "selected" : "" %>>PENDING</option>
                  <option <%= order[6] === "PROCESSING" ? "selected" : "" %>>PROCESSING</option>
                  <option <%= order[6] === "SHIPPED" ? "selected" : "" %>>SHIPPED</option>
                  <option <%= order[6] === "DELIVERED" ? "selected" : "" %>>DELIVERED</option>
                  <option <%= order[6] === "CANCELLED" ? "selected" : "" %>>CANCELLED</option>
                </select>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </section>

  <%- include('includes/admin-shell-end') %>
  <%- include('includes/footer') %>
