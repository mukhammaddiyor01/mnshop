<%- include('includes/header', { pageTitle: 'MNShop Admin | Orders', pageCss: '/css/orders.css', pageScript: '/js/orders.js' }) %>
<body class="admin-body" data-page="orders">
  <%- include('includes/admin-shell-start', { page: 'orders' }) %>

  <section class="glass-panel management-panel">
    <div class="panel-head"><div><h3>Orders Management</h3><p>Filter and update every order status</p></div><i data-lucide="sliders-horizontal"></i></div>
    <div class="table-wrap">
      <table class="admin-table" data-search-target>
        <thead><tr><th>Order</th><th>Buyer</th><th>Seller</th><th>Date</th><th>Total</th><th>Tracking</th><th>Status</th><th>Update</th></tr></thead>
        <tbody>
          <% [
            ["MN-24001", "Madina Sobirova", "Seoul Seller", "2026-05-22", "928,000 UZS", "KR-UZ-8841", "processing"],
            ["MN-24002", "Azizbek Karimov", "Busan Studio", "2026-05-23", "346,000 UZS", "Not shipped", "pending"],
            ["MN-24003", "Sevara Aliyeva", "Daegu Caps", "2026-05-21", "1,260,000 UZS", "KR-UZ-7730", "shipped"],
            ["MN-23988", "Nodir Yunusov", "Seoul Seller", "2026-05-18", "784,000 UZS", "KR-UZ-5021", "delivered"]
          ].forEach(function(order) { %>
            <tr data-status="<%= order[6] %>"><td><strong><%= order[0] %></strong></td><td><%= order[1] %></td><td><%= order[2] %></td><td><%= order[3] %></td><td><%= order[4] %></td><td><%= order[5] %></td><td><span class="status-pill <%= order[6] %>"><%= order[6] %></span></td><td><select class="status-change"><% ["pending", "processing", "shipped", "delivered", "cancelled"].forEach(function(status) { %><option value="<%= status %>" <%= order[6] === status ? "selected" : "" %>><%= status %></option><% }) %></select></td></tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </section>

  <%- include('includes/admin-shell-end') %>
  <%- include('includes/footer') %>
