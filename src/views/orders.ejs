<%- include('includes/header', { pageTitle: 'MNShop Admin | Orders', pageCss: '/css/orders.css', pageScript: '/js/orders.js' }) %>
<body class="admin-body" data-page="orders">
  <%- include('includes/admin-shell-start', { page: 'orders' }) %>

  <section class="glass-panel management-panel">
    <div class="panel-head"><div><h3>Orders Management</h3><p>Filter and update every order status</p></div><i data-lucide="sliders-horizontal"></i></div>
    <div class="table-wrap">
      <table class="admin-table" data-search-target>
        <thead><tr><th>Order</th><th>Buyer</th><th>Seller</th><th>Date</th><th>Total</th><th>Tracking</th><th>Status</th><th>Update</th></tr></thead>
        <tbody>
  <% orders.forEach(function(order, key) { %>
    <tr>
      <td>#<%= order._id.toString().slice(-6).toUpperCase() %></td>

      <td><%= order.buyerId ?? "—" %></td>

      <td>
        <%= order.productData?.[0]?.userId ?? "—" %>
      </td>

      <td>
        <%= order.createdAt
          ? new Date(order.createdAt).toLocaleDateString()
          : "—"
        %>
      </td>

      <td>$<%= Number(order.orderTotal ?? 0).toFixed(2) %></td>

      <td><%= order.orderTrackingNumber ?? "—" %></td>

      <td>
        <span class="status-badge">
          <%= order.orderStatus ?? "PENDING" %>
        </span>
      </td>

      <td>
        <select
          class="spec-select new-order-status"
          data-id="<%= order._id %>"
        >
          <option
            value="PENDING"
            <%= order.orderStatus === "PENDING" ? "selected" : "" %>
          >
            PENDING
          </option>

          <option
            value="PROCESS"
            <%= order.orderStatus === "PROCESS" ? "selected" : "" %>
          >
            PROCESS
          </option>

          <option
            value="FINISHED"
            <%= order.orderStatus === "FINISHED" ? "selected" : "" %>
          >
            FINISHED
          </option>

          <option
            value="CANCELLED"
            <%= order.orderStatus === "CANCELLED" ? "selected" : "" %>
          >
            CANCELLED
          </option>
        </select>
      </td>
    </tr>
  <% }) %>
</tbody>
      </table>
    </div>
  </section>

  <%- include('includes/admin-shell-end') %>
  <%- include('includes/footer') %>
