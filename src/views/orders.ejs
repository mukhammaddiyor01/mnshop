<%- include('includes/header', { pageTitle: 'MNShop Admin | Orders', pageCss: '/css/orders.css', pageScript: '/js/orders.js' }) %>
<body class="admin-body" data-page="orders">
  <%- include('includes/admin-shell-start', { page: 'orders' }) %>

  <section class="glass-panel management-panel">
    <div class="panel-head"><div><h3>Orders Monitoring</h3><p>Track payment, delivery, and overall order status</p></div><i data-lucide="list-checks"></i></div>
    <div class="table-wrap">
      <table class="admin-table" data-search-target>
        <thead><tr><th>Order</th><th>Buyer</th><th>Seller</th><th>Date</th><th>Total</th><th>Payment</th><th>Delivery</th><th>Order status</th><th>Tracking</th></tr></thead>
        <tbody>
  <% (orders || []).forEach(function(order) { %>
    <tr>
      <td>#<%= order._id.toString().slice(-6).toUpperCase() %></td>

      <td><%= order.buyerData?.[0]?.userNick ?? "—" %></td>

      <td>
        <%= order.sellerData?.length
          ? order.sellerData.map(function(seller) {
              return seller.sellerNick;
            }).join(", ")
          : "—"
        %>
      </td>

      <td>
        <%= order.createdAt
          ? new Date(order.createdAt).toLocaleDateString()
          : "—"
        %>
      </td>

      <td>KRW<%= Number(order.orderTotal ?? 0).toFixed(2) %></td>

      <td>
        <span class="status-badge">
          <%= order.orderPaymentStatus ?? "PENDING" %>
        </span>
      </td>

      <td>
        <span class="status-badge">
          <%= order.orderDeliveryStatus ?? "PENDING" %>
        </span>
      </td>

      <td>
        <span class="status-badge">
          <%= order.orderStatus ?? "PENDING" %>
        </span>
      </td>

      <td><%= order.orderTrackingNumber ?? "—" %></td>
    </tr>
  <% }) %>
</tbody>
      </table>
    </div>
  </section>

  <%- include('includes/admin-shell-end') %>
  <%- include('includes/footer') %>
