<%- include('includes/header', { pageTitle: 'MNShop Admin | Products', pageCss: '/css/products.css', pageScript: '/js/products.js' }) %>
<body class="admin-body" data-page="products">
  <%- include('includes/admin-shell-start', { page: 'products' }) %>

  <section class="glass-panel management-panel product-panel">
    <div class="panel-head product-panel-head">
      <div><h3>Products Management</h3><p><span data-selected-count>0</span> selected · <span data-visible-count><%= products.length %></span> visible</p></div>
      <div class="bulk-actions"><button type="button" data-bulk-action="ACTIVE">Activate</button><button type="button" data-bulk-action="PAUSE">Deactivate</button><button class="danger" type="button" data-bulk-action="DELETE">Delete Selected</button></div>
    </div>
    <div class="table-wrap">
      <table class="admin-table" data-search-target>
        <thead>
          <tr>
            <th><input type="checkbox" data-select-all /></th>
            <th>Product</th>
            <th>Type / Size / Color</th>
            <th>Price</th>
            <th>Stock</th>
            <th>Sold</th>
            <th>Featured</th>
            <th>Status</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% products.map(function(value, index) { %>
            <tr data-product-id="<%= value._id %>" data-status="<%= String(value.productStatus || 'PAUSE').toLowerCase() %>">
              <td>
                <input type="checkbox" value="<%= value._id %>" data-product-select />
              </td>

              <td>
                <strong><%= value.productName %></strong>
              </td>

              <td>
                <%= value.productType || "TSHIRT" %> ·
                <%= Array.isArray(value.productSizes) ? value.productSizes.join(", ") : (value.productSizes || "M") %> ·
                <%= Array.isArray(value.productColors) ? value.productColors.join(", ") : (value.productColors || "-") %>
              </td>

              <td>
                <%= Number(value.productDiscountPrice || value.productPrice || 0).toLocaleString() %> KRW
              </td>

              <td><%= value.productLeftCount || 0 %></td>

              <td><%= value.productSold || 0 %></td>

              <td>
                <button
                  class="feature-toggle <%= value.productFeatured ? 'active' : '' %>"
                  type="button"
                  data-feature-toggle
                  data-product-id="<%= value._id %>"
                >
                  <%= value.productFeatured ? "Featured" : "Normal" %>
                </button>
              </td>

              <td>
                <select
                  class="spec-select product-status"
                  data-product-id="<%= value._id %>"
                >
                  <option value="ACTIVE" <%= value.productStatus === "ACTIVE" ? "selected" : "" %>>ACTIVE</option>
                  <option value="PAUSE" <%= value.productStatus === "PAUSE" ? "selected" : "" %>>PAUSE</option>
                  <option value="BLOCK" <%= value.productStatus === "BLOCK" ? "selected" : "" %>>BLOCK</option>
                  <option value="DELETE" <%= value.productStatus === "DELETE" ? "selected" : "" %>>DELETE</option>
                </select>
              </td>

              <td>
                <div class="table-actions">
                  <button class="view-action" type="button" data-product-edit>
                    Edit
                  </button>
                </div>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </section>

  <%- include('includes/admin-shell-end') %>
  <%- include('includes/footer') %>
