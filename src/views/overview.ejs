<%- include('includes/header', { pageTitle: 'MNShop Admin | Overview', pageCss: '/css/overview.css', pageScript: '/js/overview.js' }) %>
<body class="admin-body" data-page="overview">
  <%- include('includes/admin-shell-start', { page: 'overview' }) %>

  <div class="kpi-grid">
    <% [
      ["users", "Total Users", "4"],
      ["badge-check", "Active Sellers", "1"],
      ["boxes", "Products", "16"],
      ["dollar-sign", "Revenue Today", "3,318,000 UZS"],
      ["bell", "Pending Orders", "1"]
    ].forEach(function(kpi) { %>
      <article class="kpi-card">
        <i data-lucide="<%= kpi[0] %>" aria-hidden="true"></i>
        <p><%= kpi[1] %></p>
        <strong><%= kpi[2] %></strong>
      </article>
    <% }) %>
  </div>

  <div class="overview-grid">
    <section class="glass-panel activity-panel">
      <h3>Real-time Activity</h3>
      <div class="activity-list">
        <% ["New order MN-24002 placed", "Busan Studio waiting approval", "Seoul Fog Hoodie marked featured", "Nodir Yunusov was blocked"].forEach(function(item) { %>
          <article><span><%= item %></span><small>now</small></article>
        <% }) %>
      </div>
    </section>

    <section class="glass-panel quick-panel">
      <h3>Quick Actions</h3>
      <div class="quick-actions">
        <a class="primary-action" href="/admin/sellers">Review Seller Applications</a>
        <a href="/admin/orders">Update Orders</a>
        <button type="button" data-maintenance-toggle>Enable Maintenance Mode</button>
      </div>
    </section>
  </div>

  <%- include('includes/admin-shell-end') %>
  <%- include('includes/footer') %>
