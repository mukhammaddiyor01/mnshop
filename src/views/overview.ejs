<%- include('includes/header', { pageTitle: 'MNShop Admin | Overview', pageCss: '/css/overview.css', pageScript: '/js/overview.js' }) %>
<body class="admin-body" data-page="overview">
  <%- include('includes/admin-shell-start', { page: 'overview', heading: 'Admin Panel', eyebrow: 'Platform Control' }) %>

  <div class="kpi-grid">
    <article class="kpi-card">
      <span class="kpi-icon">◎</span>
      <small>Total Users</small>
      <strong>1,284</strong>
    </article>
    <article class="kpi-card">
      <span class="kpi-icon">◇</span>
      <small>Active Sellers</small>
      <strong>38</strong>
    </article>
    <article class="kpi-card">
      <span class="kpi-icon">□</span>
      <small>Products</small>
      <strong>96</strong>
    </article>
    <article class="kpi-card">
      <span class="kpi-icon">$</span>
      <small>Revenue Today</small>
      <strong>4.9M</strong>
    </article>
    <article class="kpi-card">
      <span class="kpi-icon">●</span>
      <small>Pending Orders</small>
      <strong>27</strong>
    </article>
  </div>

  <div class="overview-grid">
    <section class="panel activity-panel">
      <div class="panel-head">
        <div>
          <h3>Real-time Activity</h3>
          <p>Latest storefront and admin events</p>
        </div>
        <span class="live-badge"><i></i> Live</span>
      </div>
      <div class="activity-list">
        <article><span class="activity-icon">▣</span><strong>New order MN-24002 placed</strong><small>now</small></article>
        <article><span class="activity-icon">◇</span><strong>Busan Studio waiting approval</strong><small>2 min</small></article>
        <article><span class="activity-icon">□</span><strong>Seoul Fog Hoodie marked featured</strong><small>8 min</small></article>
        <article><span class="activity-icon">◎</span><strong>Nodir Yunusov was blocked</strong><small>14 min</small></article>
      </div>
    </section>

    <section class="panel quick-panel">
      <div class="panel-head">
        <div>
          <h3>Quick Actions</h3>
          <p>Frequent admin controls</p>
        </div>
      </div>
      <div class="quick-actions">
        <a class="primary-action" href="/admin/sellers">Review Seller Applications</a>
        <a href="/admin/orders">Update Orders</a>
        <button type="button" data-maintenance-toggle>Enable Maintenance Mode</button>
      </div>
    </section>
  </div>

  <%- include('includes/admin-shell-end') %>
  <%- include('includes/footer') %>
