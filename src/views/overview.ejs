<%- include('includes/header', { pageTitle: 'MNShop Admin | Overview', pageCss: '/css/overview.css', pageScript: '/js/overview.js' }) %>
<body class="admin-body" data-page="overview">
  <%- include('includes/admin-shell-start', { page: 'overview' }) %>

  <%
    const overviewItems = [
      {
        icon: "users",
        title: "Total Users",
        value: overview.totalUsers,
      },
      {
        icon: "badge-check",
        title: "Active Sellers",
        value: overview.activeSellers,
      },
      {
        icon: "boxes",
        title: "Products",
        value: overview.totalProducts,
      },
      {
        icon: "dollar-sign",
        title: "Revenue Today",
        value: Number(overview.revenueToday || 0).toLocaleString() + " KRW",
      },
      {
        icon: "bell",
        title: "Pending Orders",
        value: overview.pendingOrders,
      },
    ];

    const activityItems = overview.activities || [];
  %>

  <div class="kpi-grid">
    <% overviewItems.map(function(value, index) { %>
      <article class="kpi-card">
        <i data-lucide="<%= value.icon %>" aria-hidden="true"></i>
        <p><%= value.title %></p>
        <strong><%= value.value %></strong>
      </article>
    <% }) %>
  </div>

  <div class="overview-grid">
    <section class="glass-panel activity-panel">
      <h3>Real-time Activity</h3>
      <div class="activity-list">
        <% activityItems.map(function(value, index) { %>
          <article>
            <span><%= value.title %></span>
            <small>
              <%= value.time ? new Date(value.time).toLocaleString() : "-" %>
            </small>
          </article>
        <% }) %>
      </div>
    </section>

    <section class="glass-panel quick-panel">
      <h3>Quick Actions</h3>
      <div class="quick-actions">
        <a class="primary-action" href="/admin/sellers">Review Seller Applications</a>
        <a href="/admin/orders">Update Orders</a>
        <button type="button" data-maintenance-toggle>Enable Maintenance Mode</button>
      </div>
    </section>
  </div>

  <%- include('includes/admin-shell-end') %>
  <%- include('includes/footer') %>
