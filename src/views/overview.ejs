<%- include('includes/header', { pageTitle: 'MNShop Admin | Overview', pageCss: '/css/overview.css', pageScript: '/js/overview.js' }) %>
<body class="admin-body" data-page="overview">
  <%- include('includes/admin-shell-start', { page: 'overview', heading: 'Overview', eyebrow: 'Live commerce pulse' }) %>

  <div class="metric-grid">
    <article class="metric-card gold">
      <span>Total Revenue</span>
      <strong>84.2M UZS</strong>
      <small>+18% this week</small>
    </article>
    <article class="metric-card">
      <span>Active Buyers</span>
      <strong>1,284</strong>
      <small>312 new in 30 days</small>
    </article>
    <article class="metric-card">
      <span>Active Sellers</span>
      <strong>38</strong>
      <small>6 pending approval</small>
    </article>
    <article class="metric-card">
      <span>Pending Orders</span>
      <strong>27</strong>
      <small>12 need shipment</small>
    </article>
  </div>

  <div class="dashboard-grid">
    <section class="panel wide">
      <div class="panel-head">
        <div>
          <p class="eyebrow">Revenue trend</p>
          <h2>Last 7 days</h2>
        </div>
        <button class="small-btn" type="button" data-toast="Revenue report exported">Export</button>
      </div>
      <div class="bar-chart" aria-label="Revenue chart">
        <% [48, 66, 52, 78, 88, 72, 96].forEach(function(value, index) { %>
          <div class="bar-item">
            <span style="height:<%= value %>%"></span>
            <small>D<%= index + 1 %></small>
          </div>
        <% }) %>
      </div>
    </section>

    <section class="panel">
      <div class="panel-head">
        <div>
          <p class="eyebrow">Best seller</p>
          <h2>Oversized Hoodie</h2>
        </div>
        <span class="status-pill success">Featured</span>
      </div>
      <div class="hero-product">
        <div class="product-orbit">MN</div>
        <div>
          <strong>Black Seoul Hoodie</strong>
          <p>316 units sold, 4.9 rating, top in Hoodies category.</p>
        </div>
      </div>
    </section>

    <section class="panel">
      <div class="panel-head">
        <div>
          <p class="eyebrow">Recent activity</p>
          <h2>Today</h2>
        </div>
      </div>
      <ul class="activity-list">
        <li><span></span>Madina placed order #MN-2048</li>
        <li><span></span>Busan Studio requested seller approval</li>
        <li><span></span>Cap collection stock dropped below 8</li>
        <li><span></span>Admin featured Seoul Hoodie</li>
      </ul>
    </section>

    <section class="panel wide">
      <div class="panel-head">
        <div>
          <p class="eyebrow">Quick actions</p>
          <h2>Admin shortcuts</h2>
        </div>
      </div>
      <div class="quick-actions">
        <a href="/admin/users/all">Review buyers</a>
        <a href="/admin/sellers">Approve sellers</a>
        <a href="/admin/product/all">Feature products</a>
        <a href="/admin/orders">Update orders</a>
      </div>
    </section>
  </div>

  <%- include('includes/admin-shell-end') %>
  <%- include('includes/footer') %>
