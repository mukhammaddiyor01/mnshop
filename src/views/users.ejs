<%- include('includes/header', { pageTitle: 'MNShop Admin | Users', pageCss: '/css/users.css', pageScript: '/js/users.js' }) %>
<body class="admin-body" data-page="users">
  <%- include('includes/admin-shell-start', { page: 'users' }) %>

  <section class="glass-panel management-panel">
    <div class="panel-head">
      <div><h3>Users Management</h3><p><span data-visible-count>
        <%= users.length %>
      </span> users visible</p></div>
      <i data-lucide="sliders-horizontal" aria-hidden="true"></i>
    </div>
    <div class="table-wrap">
      <table class="admin-table" data-search-target>
        <thead>
          <tr>
            <th>Name</th>
            <th>Email</th>
            <th>Phone</th>
            <th>Joined</th>
            <th>Orders</th>
            <th>Total</th>
            <th>Status</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% users.map(function(value, index) { %>
            <tr data-status="<%= String(value.userStatus || 'ACTIVE').toLowerCase() %>">
              <td>
                <strong><%= value.userNick %></strong>
              </td>

              <td><%= value.userEmail %></td>

              <td><%= value.userPhone || "-" %></td>

              <td>
                <%= value.createdAt ? String(value.createdAt).slice(0, 10) : "-" %>
              </td>

              <td><%= value.orderCount || 0 %></td>

              <td>
                <%= Number(value.paidTotal || 0).toLocaleString() %> KRW
              </td>

              <td>
                <select
                  class="spec-select user-status"
                  data-user-id="<%= value._id %>"
                >
                  <option
                    value="ACTIVE"
                    <%= value.userStatus === "ACTIVE" ? "selected" : "" %>
                  >
                    ACTIVE
                  </option>
                  <option
                    value="BLOCKED"
                    <%= value.userStatus === "BLOCKED" ? "selected" : "" %>
                  >
                    BLOCKED
                  </option>
                  <option
                    value="REJECTED"
                    <%= value.userStatus === "REJECTED" ? "selected" : "" %>
                  >
                    REJECTED
                  </option>
                  <option
                    value="PENDING"
                    <%= value.userStatus === "PENDING" ? "selected" : "" %>
                  >
                    PENDING
                  </option>
                  <option
                    value="DRAFT"
                    <%= value.userStatus === "DRAFT" ? "selected" : "" %>
                  >
                    DRAFT
                  </option>
                </select>
              </td>

              <td>
                <div class="table-actions">
                  <button class="view-action" type="button">
                    <i data-lucide="eye"></i>
                    View
                  </button>
                </div>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </section>

  <%- include('includes/admin-shell-end') %>
  <%- include('includes/footer') %>
