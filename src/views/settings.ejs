<%- include('includes/header', { pageTitle: 'MNShop Admin | Settings' }) %>
<body class="admin-body" data-page="settings">
  <%- include('includes/admin-shell-start', { page: 'settings', heading: 'Settings', eyebrow: 'Site, banner, and commerce preferences' }) %>

  <div class="settings-row">
    <section class="admin-box">
      <div class="box-head"><div><p class="eyebrow">Site settings</p><h2>Brand identity</h2></div></div>
      <form class="settings-form">
        <label>Site name<input value="MNShop" /></label>
        <label>Contact email<input value="support@mnshop.uz" /></label>
        <label>Phone<input value="+82 10 0000 2026" /></label>
        <label>Default commission<input value="12%" /></label>
        <button class="submit-btn" type="button" data-toast="Settings saved locally">Save changes</button>
      </form>
    </section>
    <section class="admin-box">
      <div class="box-head"><div><p class="eyebrow">Hero banners</p><h2>Homepage slider</h2></div></div>
      <div class="banner-box">
        <div><span>01</span><strong>New Drop: Oversized Hoodies</strong><em>Active</em></div>
        <div><span>02</span><strong>Seoul T-shirts for Uzbekistan</strong><em>Active</em></div>
        <div><span>03</span><strong>Caps sale weekend</strong><em>Draft</em></div>
      </div>
      <button class="line-btn full" type="button" data-toast="Banner form is frontend-ready">Add banner</button>
    </section>
    <section class="admin-box wide">
      <div class="box-head"><div><p class="eyebrow">Maintenance</p><h2>Store controls</h2></div></div>
      <div class="switch-row">
        <span>Maintenance mode</span>
        <button class="switch-btn" type="button" data-toggle-state><span></span></button>
      </div>
      <div class="switch-row">
        <span>Cookie consent banner</span>
        <button class="switch-btn active" type="button" data-toggle-state><span></span></button>
      </div>
    </section>
  </div>

  <%- include('includes/admin-shell-end') %>
  <%- include('includes/footer') %>
