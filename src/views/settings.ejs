<%- include('includes/header', { pageTitle: 'MNShop Admin | Settings', pageCss: '/css/settings.css', pageScript: '/js/settings.js' }) %>
<body class="admin-body" data-page="settings">
  <%- include('includes/admin-shell-start', { page: 'settings', heading: 'Admin Panel', eyebrow: 'Platform Control' }) %>

  <div class="settings-grid">
    <section class="panel settings-form-panel">
      <div class="panel-head"><div><h3>Site Settings</h3><p>Brand and notification preferences</p></div></div>
      <form class="admin-form" data-settings-form>
        <label>Site name<input name="siteName" value="MNShop" /></label>
        <label>Contact email<input name="contact" value="hello@mnshop.uz" /></label>
        <label>Default commission %<input name="commission" type="number" value="12" /></label>
        <label>Order SMS template<textarea name="orderSms">Buyurtmangiz holati yangilandi: {{status}}</textarea></label>
        <button class="submit-btn" type="submit">Save Settings</button>
      </form>
    </section>
    <section class="panel controls-panel">
      <span class="controls-icon">⚙</span>
      <h3>Controls</h3>
      <p>Storefront and communication controls</p>
      <label class="control-row"><span><strong>Maintenance mode</strong><small>Temporarily pause storefront purchases</small></span><button class="switch-btn" type="button" data-toggle-state><span></span></button></label>
      <button class="line-btn" type="button" data-toast="Banner draft saved">Save Banner Draft</button>
      <button class="line-btn" type="button" data-toast="Notification template tested">Send Test Notification</button>
    </section>
  </div>

  <%- include('includes/admin-shell-end') %>
  <%- include('includes/footer') %>
