<%- include('includes/header', { pageTitle: 'MNShop Admin | Settings', pageCss: '/css/settings.css', pageScript: '/js/settings.js' }) %>
<body class="admin-body" data-page="settings">
  <%- include('includes/admin-shell-start', { page: 'settings' }) %>

  <div class="settings-grid">
    <section class="glass-panel settings-form-panel">
      <h3>Site Settings</h3>
      <form class="admin-form" data-settings-form>
        <label>Site name<input name="siteName" value="mnshop" /></label>
        <label>Contact email<input name="contact" value="hello@mnshop.uz" /></label>
        <label>Default commission %<input name="commission" type="number" value="12" /></label>
        <label>Order SMS template<textarea name="orderSms">Buyurtmangiz holati yangilandi: {{status}}</textarea></label>
        <button class="primary-button" type="submit">Save Settings</button>
      </form>
    </section>
    <section class="glass-panel controls-panel">
      <i data-lucide="settings" aria-hidden="true"></i><h3>Controls</h3>
      <label class="control-row"><span><strong>Maintenance mode</strong><small>Temporarily pause storefront purchases</small></span><input type="checkbox" data-maintenance-checkbox /></label>
      <button type="button" data-toast="Banner draft saved">Save Banner Draft</button>
      <button type="button" data-toast="Notification template tested">Send Test Notification</button>
    </section>
  </div>

  <%- include('includes/admin-shell-end') %>
  <%- include('includes/footer') %>
