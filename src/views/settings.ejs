<%- include('includes/header', { pageTitle: 'MNShop Admin | Settings', pageCss: '/css/settings.css', pageScript: '/js/settings.js' }) %>
<body class="admin-body" data-page="settings">
  <%- include('includes/admin-shell-start', { page: 'settings' }) %>

  <div class="settings-grid">
    <section class="glass-panel settings-form-panel">
      <h3>Site Settings</h3>
      <form class="admin-form" action="/admin/settings" method="POST">
        <label>Site name<input name="siteName" value="<%= settings.siteName %>" required /></label>
        <label>Contact email<input name="contactEmail" type="email" value="<%= settings.contactEmail %>" required /></label>
        <label>Default commission %<input name="defaultCommission" type="number" min="0" max="100" value="<%= settings.defaultCommission %>" required /></label>
        <label>Order SMS template<textarea name="orderSmsTemplate" required><%= settings.orderSmsTemplate %></textarea></label>
        <label class="control-row">
          <span><strong>Maintenance mode</strong><small>Temporarily pause storefront purchases</small></span>
          <input name="maintenanceMode" type="checkbox" <%= settings.maintenanceMode ? "checked" : "" %> />
        </label>
        <button class="primary-button" type="submit">Save Settings</button>
      </form>
    </section>
    <section class="glass-panel controls-panel">
      <i data-lucide="settings" aria-hidden="true"></i>
      <h3>Settings Info</h3>
      <p>Changes apply to new orders and storefront controls.</p>
    </section>
  </div>

  <%- include('includes/admin-shell-end') %>
  <%- include('includes/footer') %>
