<%- include('includes/header', { pageTitle: 'MNShop Admin | Login', pageCss: '/css/login.css', pageScript: '/js/login.js' }) %>
<body class="auth-body">
  <main class="auth-screen">
    <section class="auth-panel">
      <a class="brand-mark centered" href="/admin/login">
        <span class="brand-icon">MNSHOP</span>
        <span><strong>CLOTHING_BRAND </strong>  <small>Admin Studio</small></span>
      </a>
      <h1>Welcome back</h1>
      <p>Sign in to manage buyers, sellers, products, orders, and messages.</p>
      <form class="auth-form" action="/admin/login" method="POST">
        <label>Admin nick<input name="userNick" type="text" placeholder="admin" required /></label>
        <label>Password<input name="userPassword" type="password" placeholder="Password" required /></label>
        <button class="primary-button full" type="submit">Sign In</button>
      </form>
      <!-- <a class="auth-link" href="/admin/signup">Create admin account</a> -->
    </section>
  </main>
  <%- include('includes/footer') %>
