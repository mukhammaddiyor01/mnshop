<%- include('includes/header', { pageTitle: 'MNShop Admin | Sellers' }) %>
<body class="admin-body" data-page="sellers">
  <%- include('includes/admin-shell-start', { page: 'sellers', heading: 'Seller Management', eyebrow: 'Approvals, commission, and store quality' }) %>

  <div class="page-toolbar">
    <div>
      <h2>Sellers</h2>
      <p>Approve Korean clothing sellers, block risky accounts, and adjust commissions.</p>
    </div>
    <button class="submit-btn" type="button" data-toast="Seller invite copied">Invite Seller</button>
  </div>

  <div class="cards-row">
    <article class="admin-box small-stat"><span>Pending</span><strong>6</strong><small>Need admin review</small></article>
    <article class="admin-box small-stat"><span>Active</span><strong>38</strong><small>Currently selling</small></article>
    <article class="admin-box small-stat"><span>Commission</span><strong>12%</strong><small>Default platform rate</small></article>
  </div>

  <section class="admin-box">
    <div class="table-wrap">
      <table class="data-table" data-search-target>
        <thead>
          <tr>
            <th>Seller</th>
            <th>Products</th>
            <th>Sales</th>
            <th>Revenue</th>
            <th>Commission</th>
            <th>Status</th>
          </tr>
        </thead>
        <tbody>
          <% [
            ["Seoul Studio", "18", "312", "38.4M UZS", "12%", "ACTIVE"],
            ["Busan Street Lab", "9", "104", "12.9M UZS", "10%", "PENDING"],
            ["Daegu Caps", "14", "88", "8.7M UZS", "14%", "ACTIVE"],
            ["Korea Cup House", "6", "41", "3.2M UZS", "12%", "BLOCKED"]
          ].forEach(function(row) { %>
            <tr>
              <td><div class="user-info"><div class="avatar"><%= row[0].slice(0,2).toUpperCase() %></div><div><strong><%= row[0] %></strong><small>seller@mnshop.kr</small></div></div></td>
              <td><%= row[1] %></td>
              <td><%= row[2] %></td>
              <td><%= row[3] %></td>
              <td><input class="mini-input" value="<%= row[4] %>" /></td>
              <td>
                <select class="status-change" data-toast="Seller status changed">
                  <option <%= row[5] === "ACTIVE" ? "selected" : "" %>>ACTIVE</option>
                  <option <%= row[5] === "PENDING" ? "selected" : "" %>>PENDING</option>
                  <option <%= row[5] === "REJECTED" ? "selected" : "" %>>REJECTED</option>
                  <option <%= row[5] === "BLOCKED" ? "selected" : "" %>>BLOCKED</option>
                </select>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </section>

  <%- include('includes/admin-shell-end') %>
  <%- include('includes/footer') %>
