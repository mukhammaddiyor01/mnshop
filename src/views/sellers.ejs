<%- include('includes/header', { pageTitle: 'MNShop Admin | Sellers', pageCss: '/css/sellers.css', pageScript: '/js/sellers.js' }) %>
<body class="admin-body" data-page="sellers">
  <%- include('includes/admin-shell-start', { page: 'sellers' }) %>

  <section class="glass-panel management-panel">
    <div class="panel-head"><div><h3>Sellers Management</h3><p>Approve, reject, block, and set commission</p></div><i data-lucide="sliders-horizontal"></i></div>
    <div class="table-wrap">
      <table class="admin-table" data-search-target>
        <thead>
          <tr>
            <th>Seller</th>
            <th>Email</th>
            <th>Products</th>
            <th>Sales</th>
            <th>Revenue</th>
            <th>Commission</th>
            <th>Status</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% sellers.map(function(value, index) { %>
            <tr data-status="<%= String(value.sellerStatus || 'ACTIVE').toLowerCase() %>">
              <td>
                <strong><%= value.sellerNick %></strong>
                <small><%= value.sellerPhone || "-" %></small>
              </td>

              <td><%= value.sellerEmail %></td>

              <td><%= value.sellerLeftCount || 0 %></td>

              <td><%= value.sellerTotalSales || 0 %></td>

              <td>0 KRW</td>

              <td>
                <label class="commission-input">
                  <input
                    class="seller-commission"
                    type="number"
                    value="<%= value.sellerCommisionPercentage || 0 %>"
                    data-seller-id="<%= value._id %>"
                    min="0"
                    max="100"
                  />
                  %
                </label>
              </td>

              <td>
                <select
                  class="spec-select seller-status"
                  data-seller-id="<%= value._id %>"
                >
                  <option value="ACTIVE" <%= value.sellerStatus === "ACTIVE" ? "selected" : "" %>>ACTIVE</option>
                  <option value="PENDING" <%= value.sellerStatus === "PENDING" ? "selected" : "" %>>PENDING</option>
                  <option value="DRAFT" <%= value.sellerStatus === "DRAFT" ? "selected" : "" %>>DRAFT</option>
                  <option value="BLOCKED" <%= value.sellerStatus === "BLOCKED" ? "selected" : "" %>>BLOCKED</option>
                  <option value="DELETED" <%= value.sellerStatus === "DELETED" ? "selected" : "" %>>DELETED</option>
                </select>
              </td>

              <td>
                <div class="table-actions">
                  <button class="view-action" type="button">
                    <i data-lucide="eye"></i>
                    View
                  </button>
                </div>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </section>

  <%- include('includes/admin-shell-end') %>
  <%- include('includes/footer') %>
