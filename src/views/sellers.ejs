<%- include('includes/header', { pageTitle: 'MNShop Admin | Sellers', pageCss: '/css/sellers.css', pageScript: '/js/sellers.js' }) %>
<body class="admin-body" data-page="sellers">
  <%- include('includes/admin-shell-start', { page: 'sellers', heading: 'Admin Panel', eyebrow: 'Platform Control' }) %>

  <section class="panel management-panel">
    <div class="panel-head">
      <div>
        <h3>Sellers Management</h3>
        <p>Approve, reject, block, and set commission</p>
      </div>
      <span class="panel-control">☷</span>
    </div>
    <div class="table-wrap">
      <table class="admin-table" data-search-target>
        <thead><tr><th>Seller</th><th>Email</th><th>Products</th><th>Sales</th><th>Revenue</th><th>Commission</th><th>Status</th><th>Actions</th></tr></thead>
        <tbody>
          <% [
            ["Seoul Seller", "seller@mnshop.uz", "+82 10 2400 1001", 18, 624, "84.2M UZS", 12, "active"],
            ["Busan Studio", "busan@mnshop.uz", "+82 10 2400 1002", 12, 218, "29.1M UZS", 10, "pending"],
            ["Daegu Caps", "daegu@mnshop.uz", "+82 10 2400 1003", 7, 98, "14.8M UZS", 15, "blocked"]
          ].forEach(function(seller) { %>
            <tr data-status="<%= seller[7] %>">
              <td><strong><%= seller[0] %></strong><small><%= seller[2] %></small></td>
              <td><%= seller[1] %></td><td><%= seller[3] %></td><td><%= seller[4] %></td><td><%= seller[5] %></td>
              <td><label class="commission-input"><input type="number" value="<%= seller[6] %>" />%</label></td>
              <td><span class="status-pill <%= seller[7] %>"><%= seller[7] %></span></td>
              <td><div class="table-actions"><button class="approve-action" type="button" data-seller-status="active">Approve</button><button class="reject-action" type="button" data-seller-status="rejected">Reject</button><button class="delete-action" type="button" data-seller-status="blocked"><%= seller[7] === "blocked" ? "Unblock" : "Block" %></button></div></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </section>

  <%- include('includes/admin-shell-end') %>
  <%- include('includes/footer') %>
